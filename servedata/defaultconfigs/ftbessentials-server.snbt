# DragonMineManorsZ - comandos de teleporte do FTB Essentials
# Este arquivo e copiado para world/serverconfig na criacao do mundo.

{
	teleportation: {
		back: {
			enabled: true
			cooldown: 30
			warmup: 3
			max: 10
			only_on_death: false
		}

		# Vazio significa que home, warp e TPA podem atravessar dimensoes.
		blacklists: {
			from: [ ]
			to: [ ]
		}

		home: {
			enabled: true
			cooldown: 10
			warmup: 3
			max: 3
		}

		playerspawn: {
			enabled: true
			cooldown: 10
			warmup: 3
		}

		# RTP fica limitado ao Overworld para nao quebrar dimensoes de progressao.
		rtp: {
			enabled: true
			cooldown: 600
			warmup: 5
			dimension_blacklist: [ ]
			dimension_whitelist: ["minecraft:overworld"]
			min_distance: 1000
			max_distance: 15000
			max_tries: 100
		}

		spawn: {
			enabled: true
			cooldown: 10
			warmup: 3
		}

		tpa: {
			enabled: true
			cooldown: 10
			warmup: 3
		}

		jump: { enabled: true }
		tpl: { enabled: true }
		tpx: { enabled: true }

		warp: {
			enabled: true
			cooldown: 10
			warmup: 3
		}
	}
}
